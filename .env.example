# SAM SPACE configuration. Copy to .env and fill in ONE key. Never commit .env.
#
# The app reads .env from this folder first, then from the folder ABOVE it
# (the teaching-staff layout: submissions/.env + submissions/sam-space/).
# Values already set in your shell always win.

# --- AI key (one is enough) ---------------------------------------------------
# Personal OpenAI key: enables model routing across Luna, Sol, and Astra.
OPENAI_API_KEY=your-openai-api-key-here
# Course Portkey key: restricted to gpt-6-luna only. Sol/Astra are never attempted.
PORTKEY_API_KEY=your-portkey-api-key-here

# auto = OpenAI if OPENAI_API_KEY is set, otherwise Portkey. Or force: openai | portkey
AI_PROVIDER=auto

# --- Optional: model tiers (defaults verified 2026-10-24) -----------------------
# MODEL_FAST=gpt-6-luna
# MODEL_INTERMEDIATE=gpt-6.1-sol
# MODEL_INTERMEDIATE_FALLBACK=gpt-6-sol
# MODEL_ADVANCED=gpt-6-astra
# MODEL_ADVANCED_FALLBACK=gpt-6.1-sol

# --- Optional: spending limits -----------------------------------------------
# WORKFLOW_BUDGET_USD=0.50
# DAILY_BUDGET_USD=5.00
# MAX_MODEL_CALLS_PER_WORKFLOW=20
# MAX_AGENT_ITERATIONS=8
# MAX_HANDOFFS_PER_RUN=12
# MAX_REVISIONS=1                 # hard cap 2
# MAX_WEB_SEARCHES_PER_RUN=4
# MAX_PAGE_FETCHES_PER_RUN=10

# --- Optional: app ---------------------------------------------------------
# SESSION_HOURS=8
# DEMO_PASSWORD=          # override the demo sign-in password
# DATABASE_PATH=          # default: backend/data/sam_space.db
# VERIFY_MODELS_ON_STARTUP=true
